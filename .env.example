# Secrets + per-deployment values for docker-compose.yml (Authentik OIDC mode).
# Copy to .env (gitignored) and fill in. Everything else lives in docker-compose.yml.
#
#   cp .env.example .env

# --- Authentik ---------------------------------------------------------------
# From the Authentik OAuth2/OpenID Provider bound to the "plane-mcp" application
# (Applications > Providers > plane-mcp). Client type must be Confidential.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# --- Encryption --------------------------------------------------------------
# Derives the Fernet key that encrypts linked PATs at rest and signs the
# provision page's session cookies. Generate once and keep it stable:
#
#   openssl rand -base64 48
#
# Changing it makes every already-linked PAT undecryptable — users are silently
# treated as unlinked and must relink.
MCP_PAT_ENCRYPTION_KEY=

# --- Plane -------------------------------------------------------------------
# Default workspace slug offered to users who haven't picked one.
PLANE_WORKSPACE_SLUG=
